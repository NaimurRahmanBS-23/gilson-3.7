@model Nop.Plugin.Misc.DiscountManagerPlus.Admin.Models.PromotionRuleConditionSearchModel
@using Nop.Plugin.Misc.DiscountManagerPlus.Admin.Infrastructure
@using Nop.Web.Framework
@using Nop.Web.Framework.UI
@using System.Web.Routing
@{
    Html.AddScriptParts("~/Scripts/jquery.tmpl.min.js");
    var pluginAdmin = new RouteValueDictionary { { "Namespaces", "Nop.Plugin.Misc.DiscountManagerPlus.Admin.Controllers" }, { "area", "" } };
}

<script type="text/javascript">
    $(function () {
        loadRuleConditions();
    });

    function refreshConditionsGrid() {
        loadRuleConditions();
    }

    function loadRuleConditions(conditionId, groupId, interactionTypeId, deleteCondition, deleteGroup) {
        var postData = {
            promotionRuleId: @Model.PromotionRuleId,
            conditionId: (typeof conditionId === 'undefined' ? 0 : conditionId),
            groupId: (typeof groupId === 'undefined' ? 0 : groupId),
            interactionTypeId: (typeof interactionTypeId === 'undefined' ? 0 : interactionTypeId),
            deleteCondition: (typeof deleteCondition === 'undefined' ? false : deleteCondition),
            deleteGroup: (typeof deleteGroup === 'undefined' ? false : deleteGroup)
        };

        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            type: "POST",
            url: "@(Url.Action("GetRuleConditions", "PromotionRule", pluginAdmin))",
            data: postData,
            success: function (data) {
                loadConditionBoxes(data.Conditions, "#ruleConditionContainer", true);
                updateGroupSelect(data.AvailableGroups, data.NextGroupId);
            },
            error: function () {
                alert('@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.Alert.FailedGet")');
            }
        });
    }

    function loadConditionBoxes(conditions, placeholder, hideEmptyString) {
        if (conditions.length > 0 || hideEmptyString)
            $(placeholder).html('');
        else
            $(placeholder).html('@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.GroupIsEmpty")');

        $("#ruleConditionTemplate").tmpl(conditions).appendTo(placeholder);

        for (var i = 0; i < conditions.length; i++) {
            if (!conditions[i].ChildRequirements || conditions[i].ChildRequirements.length === 0)
                continue;

            var placeholderName = conditions[i].IsGroup
                ? '#ruleconditionplaceholder-g' + conditions[i].GroupId
                : '#ruleconditionplaceholder-c' + conditions[i].ConditionId;
            $(placeholderName).html('loading...');
            loadConditionBoxes(conditions[i].ChildRequirements, placeholderName, false);
        }
    }

    function updateGroupSelect(groups, nextGroupId) {
        var groupsElement = $("#ConditionGroupId");
        groupsElement.html('');
        $.each(groups, function (id, option) {
            groupsElement.append($('<option></option>').val(option.Value).html(option.Text));
        });

        groupsElement.data('nextGroup', nextGroupId || 1);
        if (groups.length > 1) {
            $("#pnlGroup").show();
        } else {
            $("#pnlGroup").hide();
        }
    }

    function openRuleConditionCreatePopup(addNewGroup) {
        var groupId = 0;
        if (addNewGroup) {
            groupId = $("#ConditionGroupId").data('nextGroup') || 1;
        } else {
            groupId = parseInt($("#ConditionGroupId").val(), 10) || 1;
        }

        var url = '@Html.Raw(PluginAdminUrl.Combine(Url.Action("RuleConditionCreatePopup", "PromotionRule", pluginAdmin), "promotionRuleId=" + Model.PromotionRuleId))';
        if (groupId > 0)
            url += '&conditionGroup=' + groupId;

        OpenWindow(url, 860, 760, true);
        return false;
    }

    function openRuleConditionEditPopup(id) {
        OpenWindow('@Html.Raw(Url.Content("~/Plugins/PromotionRule/RuleConditionEditPopup/"))' + id, 860, 760, true);
        return false;
    }

    function deleteCondition(id) {
        loadRuleConditions(id, 0, 0, true, false);
    }

    function deleteConditionGroup(groupId) {
        loadRuleConditions(0, groupId, 0, false, true);
    }

    function changeInteraction(groupId, typeId) {
        loadRuleConditions(0, groupId, typeId, false, false);
    }
</script>

<div id="ruleConditionContainer"></div>

<script id="ruleConditionTemplate" type="text/html">
    <div class="requirement-container {{if IsGroup}}requirement-group{{/if}}" id="rulecondition{{if IsGroup}}${GroupId}{{else}}${ConditionId}{{/if}}">
        <div class="requirement-heading clearfix">
            {{if IsGroup}}
            <span style="float:left; margin-right:5px;">
                @T("Admin.NopStation.DiscountManagerPlus.RuleConditions.Group.Title")
                <i>${RuleName}</i>
            </span>
            <div class="interaction-type" style="float:left;">
                <span style="float:left; margin-right:10px;">@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.InteractionTypeInGroup")</span>
                <select id="interactiontype${GroupId}" name="interactiontype${GroupId}" onchange="changeInteraction(${GroupId}, this.value)">
                    {{each AvailableInteractionTypes}}
                        {{if Selected}}
                            <option value="${Value}" selected="selected">${Text}</option>
                        {{else}}
                            <option value="${Value}">${Text}</option>
                        {{/if}}
                    {{/each}}
                </select>
            </div>
            <input type="button" class="k-button" value="@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.RemoveGroup")" onclick="deleteConditionGroup(${GroupId})" />
            {{else}}
            <div style="float:left;">
                @T("Admin.NopStation.DiscountManagerPlus.RuleConditions.Condition.Title")
            </div>
            <div style="float:right;">
                <input type="button" class="k-button" value="@T("Admin.Common.Edit")" onclick="openRuleConditionEditPopup(${ConditionId})" />
                <input type="button" class="k-button" value="@T("Admin.Common.Delete")" onclick="deleteCondition(${ConditionId})" />
            </div>
            {{/if}}
        </div>
        <div class="requirement-body">
            {{if IsGroup}}
            <div id="ruleconditionplaceholder-g${GroupId}"></div>
            {{else}}
            <div class="requirement-summary">{{html Summary}}</div>
            {{if ChildRequirements && ChildRequirements.length > 0}}
            <div id="ruleconditionplaceholder-c${ConditionId}"></div>
            {{/if}}
            {{/if}}
        </div>
    </div>
    {{if !IsGroup && !IsLastInGroup}}
    <div class="interaction-type-label">
        ${InteractionType}
    </div>
    {{/if}}
</script>

<table class="adminContent">
    <tr>
        <td colspan="2">
            <strong>@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.AddNew")</strong>
        </td>
    </tr>
    <tr id="pnlGroup" style="display:none;">
        <td class="adminTitle">
            @T("Admin.NopStation.DiscountManagerPlus.RuleConditions.Fields.ConditionGroup"):
        </td>
        <td class="adminData">
            <select id="ConditionGroupId"></select>
        </td>
    </tr>
    <tr>
        <td colspan="2">
            <input type="button" class="k-button" value="@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.AddNew")" onclick="openRuleConditionCreatePopup(false); return false;" />
            <input type="button" class="k-button" value="@T("Admin.NopStation.DiscountManagerPlus.RuleConditions.AddGroup")" onclick="openRuleConditionCreatePopup(true); return false;" />
        </td>
    </tr>
</table>
