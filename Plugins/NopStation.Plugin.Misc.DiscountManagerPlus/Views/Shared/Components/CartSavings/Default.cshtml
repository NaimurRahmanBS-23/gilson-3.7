@model NopStation.Plugin.Misc.DiscountManagerPlus.Models.CartSavingsModel
@using NopStation.Plugin.Misc.DiscountManagerPlus
@{
    var cartSavingsCssUrl = Url.Content("~/Plugins/NopStation.Plugin.Misc.DiscountManagerPlus/Content/css/cart-savings.css");
    var autoOpenPopupId = Model.PendingRewards.FirstOrDefault()?.PopupId;
    var rewardSelectionRequiredMessage = T("Plugins.NopStation.DiscountManagerPlus.RewardSelection.Error.SelectionRequired").Text;
    var rewardAddFailedMessage = T("Plugins.NopStation.DiscountManagerPlus.RewardSelection.Error.AddFailed").Text;
}

<script>
    (function () {
        var href = '@cartSavingsCssUrl';
        if (document.querySelector('link[data-ns-dmp-cart-savings-css]')) {
            return;
        }

        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = href;
        link.setAttribute('data-ns-dmp-cart-savings-css', 'true');
        document.head.appendChild(link);
    })();
</script>

<div class="ns-discount-manager-plus-cart-root ns-dmp-cart-savings-root"
    data-auto-open-popup="@(string.IsNullOrWhiteSpace(autoOpenPopupId) ? string.Empty : "#" + autoOpenPopupId)"
    data-reward-error="@rewardAddFailedMessage">
    @if (Model.Reminders.Any())
    {
        <div class="ns-discount-manager-plus-reminders">
            <div class="title">@Model.ReminderTitle</div>
            <ul>
                @foreach (var reminder in Model.Reminders)
                {
                    <li>@reminder</li>
                }
            </ul>
        </div>
    }

    @* NEW: Display multiple discount notices *@
    @if (Model.MultipleDiscountNotices.Any())
    {
        <div class="ns-discount-manager-plus-notice">
            <div class="notice-icon">✨</div>
            <div class="notice-content">
                @foreach (var notice in Model.MultipleDiscountNotices)
                {
                    <div class="notice-message">@notice</div>
                }
            </div>
        </div>
    }

    @* NEW: Display cheapest item selection details *@
    @if (Model.CheapestItemSelectionDetails.Any())
    {
        <div class="ns-discount-manager-plus-details">
            <div class="details-title">@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.SavingsBreakdown")</div>
            <ul>
                @foreach (var detail in Model.CheapestItemSelectionDetails)
                {
                    <li>@detail</li>
                }
            </ul>
        </div>
    }

    @* NEW: Display excluded product warnings *@
    @if (Model.ExcludedProductWarnings.Any())
    {
        <div class="ns-discount-manager-plus-warning">
            <div class="warning-icon">⚠️</div>
            <div class="warning-content">
                @foreach (var warning in Model.ExcludedProductWarnings)
                {
                    <div class="warning-message">@warning</div>
                }
            </div>
        </div>
    }

    @* NEW: Dual-Offer Attention Messages *@
    @if (Model.HasAttentionMessages && Model.IsDualOfferScenario)
    {
        <div class="ns-discount-manager-plus-dual-offer">
            <div class="dual-offer-icon">🎯</div>
            <div class="dual-offer-content">
                @foreach (var message in Model.AttentionMessages.Where(m => m.IsDualOfferScenario))
                {
                    <div class="dual-offer-message @(message.IsHighlighted ? "is-highlighted" : "")" data-priority="@message.DisplayPriority">
                        <div class="message-header">
                            <strong>@message.RuleName</strong>
                            @if (message.MessageType == NopStation.Plugin.Misc.DiscountManagerPlus.Domain.AttentionMessageType.Boost)
                            {
                                <span class="badge-boost">💥 Boost</span>
                            }
                            else if (message.MessageType == NopStation.Plugin.Misc.DiscountManagerPlus.Domain.AttentionMessageType.Opportunity)
                            {
                                <span class="badge-opportunity">💡 Opportunity</span>
                            }
                        </div>
                        <div class="message-text">@message.Message</div>

                        @if (!string.IsNullOrEmpty(message.DiscountChoiceExplanation))
                        {
                            <div class="discount-explanation">
                                <em>@message.DiscountChoiceExplanation</em>
                            </div>
                        }

                        @if (message.ChosenItemReasons?.Any() == true)
                        {
                            <div class="choice-reasons">
                                <ul>
                                    @foreach (var reason in message.ChosenItemReasons)
                                    {
                                        <li>@reason</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* NEW: Savings Maximization Tips *@
    @if (Model.HasMaximizationTips)
    {
        <div class="ns-discount-manager-plus-maximization">
            <div class="maximization-icon">💡</div>
            <div class="maximization-content">
                <div class="maximization-title">@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.MaximizationTitle")</div>

                @foreach (var tip in Model.MaximizationTips.OrderByDescending(t => t.Priority).ThenByDescending(t => t.PotentialSavings).Take(3))
                {
                    <div class="maximization-tip @(tip.IsQuickWin ? "is-quick-win" : "")">
                        <div class="tip-content">
                            <div class="tip-message">@tip.Message</div>
                            @if (tip.PotentialSavings > 0)
                            {
                                <div class="tip-savings">Save additional $@tip.PotentialSavings:F2</div>
                            }
                            @if (tip.SuggestedProducts?.Any() == true)
                            {
                                <div class="tip-products">
                                    <span>Consider adding: @string.Join(", ", tip.SuggestedProducts)</span>
                                </div>
                            }
                            @if (tip.IsQuickWin)
                            {
                                <div class="tip-quick-win">⚡ Quick Win</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* NEW: Dual-Offer Explanation *@
    @if (Model.IsDualOfferScenario && Model.DualOfferExplanation != null)
    {
        <div class="ns-discount-manager-plus-explanation">
            <div class="explanation-icon">📊</div>
            <div class="explanation-content">
                <div class="explanation-title">@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.HowDiscountsApplied")</div>
                <div class="explanation-text">@Model.DualOfferExplanation.ExplanationText</div>

                @if (Model.DualOfferExplanation.DiscountChoices?.Any() == true)
                {
                    <div class="explanation-breakdown">
                        <div class="breakdown-title">@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.DiscountBreakdown")</div>
                        @foreach (var choice in Model.DualOfferExplanation.DiscountChoices.OrderByDescending(c => c.Priority))
                        {
                            <div class="explanation-choice" data-priority="@choice.Priority">
                                <div class="choice-promotion">@choice.PromotionName</div>
                                <div class="choice-details">
                                    <span class="choice-product">@choice.ProductName</span>
                                    @if (choice.UnitNumber.HasValue)
                                    {
                                        <span class="choice-unit">(Unit @choice.UnitNumber)</span>
                                    }
                                    <span class="choice-discount">@choice.DiscountType</span>
                                    <span class="choice-amount">$@choice.DiscountAmount:F2</span>
                                </div>
                                @if (!string.IsNullOrEmpty(choice.Reasoning))
                                {
                                    <div class="choice-reasoning">
                                        <small>@choice.Reasoning</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Model.DualOfferExplanation.SavingsPercentage > 0)
                {
                    <div class="explanation-savings">
                        <span>@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.TotalSavingsPercentage"): </span>
                        <strong>@Model.DualOfferExplanation.SavingsPercentage:F1%</strong>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.PendingRewards.Any())
    {
        <div class="ns-dmp-cart-savings-panel ns-dmp-cart-savings-panel--rewards">
            <div class="ns-dmp-cart-savings-panel__header">
                <h4>@Model.PendingRewardsTitle</h4>
                <p>@Model.PendingRewardsDescription</p>
            </div>
            <div class="ns-dmp-cart-reward-list">
                @foreach (var reward in Model.PendingRewards)
                {
                    var heroImage = reward.Options.FirstOrDefault()?.ImageUrl ?? string.Empty;
                    <div class="ns-dmp-cart-reward-card">
                        <div class="ns-dmp-cart-reward-card__image">
                            @if (!string.IsNullOrWhiteSpace(heroImage))
                            {
                                <img src="@heroImage" alt="@reward.RuleName" loading="lazy" />
                            }
                        </div>
                        <div class="ns-dmp-cart-reward-card__content">
                            <div class="ns-dmp-cart-reward-card__rule">
                                <span>@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.RuleLabel"):</span>
                                <span>@reward.RuleName</span>
                            </div>
                            <h5 class="ns-dmp-cart-reward-card__title">@Model.PendingRewardsTitle</h5>
                            <div class="ns-dmp-cart-reward-card__meta">
                                <span>@T("Plugins.NopStation.DiscountManagerPlus.CartSavings.QuantityLabel"):</span>
                                <strong>x@reward.RewardQuantity</strong>
                            </div>
                            <div class="ns-dmp-cart-reward-card__button">
                                <button type="button" class="button-2 js-ns-dmp-reward-open" data-mfp-src="#@reward.PopupId">@Model.PendingRewardsSelectText</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        foreach (var reward in Model.PendingRewards)
        {
            if (!reward.Options.Any())
            {
                continue;
            }

            <div id="@reward.PopupId" class="mfp-hide ns-dmp-cart-reward-popup">
                <form id="@reward.FormId"
                      data-action="@reward.AddToCartUrl"
                      data-max-selection="@reward.MaxSelectableQuantity"
                      data-selection-required="@rewardSelectionRequiredMessage"
                      class="ns-dmp-cart-reward-popup__form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="promotionRuleId" value="@reward.PromotionRuleId" />
                    <input type="hidden" name="rewardQuantity" value="@reward.RewardQuantity" />

                    <div class="ns-dmp-cart-reward-popup__eyebrow">@T("Plugins.NopStation.DiscountManagerPlus.RewardSelection.Badge.Free")</div>
                    <h3 class="ns-dmp-cart-reward-popup__title">@Model.PendingRewardsTitle</h3>
                    <div class="ns-dmp-cart-reward-popup__rule">@reward.RuleName</div>

                    <div class="ns-dmp-reward-option-grid">
                        @foreach (var option in reward.Options)
                        {
                            <label class="ns-dmp-reward-option @(option.IsSelected ? "is-selected" : string.Empty)" data-option-id="@option.RewardProductId">
                                <input class="ns-dmp-reward-option__radio" type="radio" name="rewardProductId" value="@option.RewardProductId" checked="@(option.IsSelected)" />
                                <span class="ns-dmp-reward-option__badge">@T("Plugins.NopStation.DiscountManagerPlus.RewardSelection.Badge.Free")</span>
                                <span class="ns-dmp-reward-option__media">
                                    @if (!string.IsNullOrWhiteSpace(option.ImageUrl))
                                    {
                                        <img src="@option.ImageUrl" alt="@option.RewardProductName" loading="lazy" />
                                    }
                                </span>
                                <span class="ns-dmp-reward-option__content">
                                    <span class="ns-dmp-reward-option__title">@option.RewardProductName</span>
                                    @if (!string.IsNullOrWhiteSpace(option.RewardProductPrice))
                                    {
                                        <span class="ns-dmp-reward-option__price-wrap">
                                            @if (!string.IsNullOrWhiteSpace(option.RewardProductOldPrice) &&
                                                 option.RewardProductOldPrice != option.RewardProductPrice)
                                            {
                                                <span class="ns-dmp-reward-option__old-price"><s>@option.RewardProductOldPrice</s></span>
                                            }
                                            <span class="ns-dmp-reward-option__price">@option.RewardProductPrice</span>
                                        </span>
                                    }
                                </span>
                            </label>
                        }
                    </div>

                    @foreach (var option in reward.Options)
                    {
                        var attributesModel = new NopStation.Plugin.Misc.DiscountManagerPlus.Models.RewardProductAttributesModel
                        {
                            Product = option.Product,
                            FormId = reward.FormId
                        };

                        <div class="ns-dmp-reward-attributes @(option.IsSelected ? string.Empty : "is-hidden")" data-option-id="@option.RewardProductId">
                            @await Html.PartialAsync("~/Plugins/NopStation.Plugin.Misc.DiscountManagerPlus/Views/Shared/Components/CartSavings/_RewardProductAttributes.cshtml", attributesModel)
                        </div>
                    }

                    <div class="ns-dmp-cart-reward-popup__message is-hidden"></div>
                    <div class="ns-dmp-cart-reward-popup__actions">
                        <button type="submit" class="ns-dmp-cart-reward-popup__submit js-ns-dmp-reward-add">
                            <span class="ns-dmp-cart-reward-popup__submit-text">@Model.PendingRewardsAddText</span>
                        </button>
                    </div>
                </form>
            </div>
        }
    }

    @if (Model.Items.Any())
    {
        <div class="ns-discount-manager-plus-savings">
            @if (!string.IsNullOrWhiteSpace(Model.SummaryText))
            {
                <div class="summary">@Model.SummaryText</div>
            }
            <div class="title">@Model.Title</div>
            <ul>
                @foreach (var item in Model.Items)
                {
                    <li class="@(item.IsBogoStyle ? "bogo-item" : "discount-item")">
                        <span class="item-left">
                            @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                            {
                                <span class="badge">@item.BadgeText</span>
                            }
                            <span class="name">@item.RuleName</span>
                            @if (!string.IsNullOrWhiteSpace(item.DetailText))
                            {
                                <small class="detail">@item.DetailText</small>
                            }
                            @* NEW: Show which item received the discount *@
                            @if (!string.IsNullOrWhiteSpace(item.AppliedToText))
                            {
                                <small class="applied-to">@item.AppliedToText</small>
                            }
                        </span>
                        <span class="amount">@item.DiscountAmountFormatted</span>
                    </li>
                }
            </ul>
            <div class="total">
                <span>@Model.TotalLabel</span>
                <strong>@Model.TotalSavingsFormatted</strong>
            </div>
            <div class="offers-link">
                <a href="@(Url.RouteUrl(DiscountManagerPlusDefaults.OffersRouteName) ?? "/promotions/offers")">@T("Plugins.NopStation.DiscountManagerPlus.Offers.LinkText")</a>
            </div>
        </div>
    }
</div>

@if (Model.Items.Any() || Model.PendingRewards.Any() || Model.Reminders.Any())
{
    if (Model.PendingRewards.Any())
    {
        <link rel="stylesheet" href="~/lib_npm/magnific-popup/magnific-popup.css" />
        <script asp-exclude-from-bundle="true" src="~/lib_npm/magnific-popup/jquery.magnific-popup.min.js" asp-location="Footer"></script>
        <script asp-exclude-from-bundle="true" src="~/Plugins/NopStation.Plugin.Misc.DiscountManagerPlus/Content/js/cart-savings.js" asp-location="Footer"></script>
    }
    <script asp-location="Footer">
        $(function () {
            var rootContainer = $('.ns-discount-manager-plus-cart-root').first();
            var savingsBlock = rootContainer.find('.ns-discount-manager-plus-savings').first();
            var orderSummaryContent = $('.order-summary-content').first();
            
            // Move savings block above order summary content, keep in widget zone if target not found
            if (savingsBlock.length > 0 && orderSummaryContent.length > 0) {
                savingsBlock.insertBefore(orderSummaryContent);
            }
            
            // Ensure root container remains visible even if it becomes empty after moving savings block
            if (rootContainer.length > 0) {
                rootContainer.css('display', 'block');
            }
        });
    </script>
}
