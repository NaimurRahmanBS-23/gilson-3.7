@model PromotionRuleExcludedProductSearchModel

@{
    var excludedProductColumns = new List<ColumnProperty>
    {
        new(nameof(PromotionRuleExcludedProductModel.ProductName))
        {
            Title = T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.Fields.ProductName").Text,
            Encode = false
        },
        new(nameof(PromotionRuleExcludedProductModel.Sku))
        {
            Title = T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.Fields.Sku").Text,
            Width = "120"
        },
        new(nameof(PromotionRuleExcludedProductModel.Price))
        {
            Title = T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.Fields.Price").Text,
            Width = "100",
        },
        new(nameof(PromotionRuleExcludedProductModel.CreatedOnUtc))
        {
            Title = T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.Fields.CreatedOn").Text,
            Width = "150",
            Render = new RenderDate()
        }
    };

    excludedProductColumns.Add(new ColumnProperty(nameof(PromotionRuleExcludedProductModel.Id))
    {
        Title = T("Admin.Common.Delete").Text,
        Width = "80",
        ClassName = NopColumnClassDefaults.Button,
        Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
    });
}

<div class="card-body">
    <div class="row mb-3">
        <div class="col-12">
            <div class="form-text">
                @T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.Description")
            </div>
        </div>
    </div>
    <div class="row mb-3">
        <div class="text-right col-12">
            <button type="button"
                    class="btn btn-secondary"
                    onclick="OpenWindow('@Url.Action("ExcludedProductAddMultiplePopup", new { promotionRuleId = Model.PromotionRuleId })', 1100, 800, true); return false;">
                <i class="fas fa-ban"></i>
                @T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.AddExcludedProducts")
            </button>
            <button type="button"
                    class="btn btn-danger"
                    id="btnBulkDeleteExcludedProducts"
                    onclick="bulkDeleteExcludedProducts();">
                <i class="fas fa-trash"></i>
                @T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.BulkDelete")
            </button>
            <button type="submit" id="btnRefreshExcludedProducts" class="d-none"></button>
        </div>
    </div>

    <div class="table-responsive">
        @await Html.PartialAsync("Table", new DataTablesModel
        {
            Name = "excluded-products-grid",
            UrlRead = new DataUrl("ExcludedProductList", "PromotionRule", new RouteValueDictionary { ["PromotionRuleId"] = Model.PromotionRuleId }),
            UrlDelete = new DataUrl("ExcludedProductDelete", "PromotionRule", null),
            SearchButtonId = "btnRefreshExcludedProducts",
            Length = Model.PageSize,
            LengthMenu = Model.AvailablePageSizes,
            Filters = new List<FilterParameter>
            {
                new(nameof(Model.PromotionRuleId))
            },
            ColumnCollection = excludedProductColumns
        })
    </div>
</div>

<script asp-location="Footer">
    function refreshExcludedProductsGrid() {
        $('#excluded-products-grid').DataTable().ajax.reload();
    }

    function bulkDeleteExcludedProducts() {
        var selectedIds = $('#excluded-products-grid').DataTable().rows('.selected').data().map(function(row) {
            return row.Id;
        }).toArray();

        if (selectedIds.length === 0) {
            alert('@T("Admin.NopStation.DiscountManagerPlus.ExcludedProducts.SelectExcludedProducts")');
            return;
        }

        if (!confirm('@T("Admin.Common.AreYouSure")'))
            return;

        $.ajax({
            url: '@Url.Action("ExcludedProductBulkDelete", "PromotionRule")',
            type: 'POST',
            data: { selectedIds: selectedIds },
            success: function(data) {
                if (data.Result) {
                    refreshExcludedProductsGrid();
                }
            }
        });
    }
</script>
