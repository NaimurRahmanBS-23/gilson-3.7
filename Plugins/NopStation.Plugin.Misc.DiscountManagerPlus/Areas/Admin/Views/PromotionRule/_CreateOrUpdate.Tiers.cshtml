@model PromotionRuleTierSearchModel

<div class="card-body">
    <div class="row mb-3">
        <div class="text-right col-12">
            <button type="button"
                    class="btn btn-primary"
                    onclick="OpenWindow('@Url.Action("RuleTierCreatePopup", new { promotionRuleId = Model.PromotionRuleId, btnId = "btnRefreshTiers", formId = "tier-popup-form" })', 700, 600, true); return false;">
                <i class="fas fa-plus-square"></i>
                @T("Admin.Common.AddNew")
            </button>
            <button type="submit" id="btnRefreshTiers" class="d-none"></button>
        </div>
    </div>

    <div class="table-responsive">
        @await Html.PartialAsync("Table", new DataTablesModel
        {
            Name = "rule-tiers-grid",
            UrlRead = new DataUrl("RuleTierList", "PromotionRule", new RouteValueDictionary { ["PromotionRuleId"] = Model.PromotionRuleId }),
            UrlDelete = new DataUrl("RuleTierDelete", "PromotionRule", null),
            SearchButtonId = "btnRefreshTiers",
            Length = Model.PageSize,
            LengthMenu = Model.AvailablePageSizes,
            Filters = new List<FilterParameter>
            {
                new(nameof(Model.PromotionRuleId))
            },
            ColumnCollection = new List<ColumnProperty>
            {
                new(nameof(PromotionRuleTierModel.MinQuantity)) { Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.MinQuantity").Text },
                new(nameof(PromotionRuleTierModel.MaxQuantity)) { Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.MaxQuantity").Text },
                new(nameof(PromotionRuleTierModel.AppliesToRuleProductsSummary))
                {
                    Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.AppliesToRuleProducts").Text
                },
                new(nameof(PromotionRuleTierModel.DiscountTypeName)) { Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.DiscountType").Text },
                new(nameof(PromotionRuleTierModel.DiscountValue)) { Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.DiscountValue").Text },
                new(nameof(PromotionRuleTierModel.RewardQuantity)) { Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.RewardQuantity").Text },
                new(nameof(PromotionRuleTierModel.AutoAddReward))
                {
                    Title = T("Admin.NopStation.DiscountManagerPlus.RuleTiers.Fields.AutoAddReward").Text,
                    Width = "100",
                    Render = new RenderBoolean()
                },
                new(nameof(PromotionRuleTierModel.Id))
                {
                    Title = T("Admin.Common.Edit").Text,
                    Width = "80",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonCustom(NopButtonClassDefaults.Default, T("Admin.Common.Edit").Text)
                    {
                        OnClickFunctionName = "openRuleTierEditPopup"
                    }
                },
                new(nameof(PromotionRuleTierModel.Id))
                {
                    Title = T("Admin.Common.Delete").Text,
                    Width = "80",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text)
                }
            }
        })
    </div>
</div>

<script asp-location="Footer">
    function openRuleTierEditPopup(id) {
        OpenWindow('@Url.Action("RuleTierEditPopup")?id=' + id, 700, 600, true);
        return false;
    }

    function refreshTiersGrid() {
        $('#rule-tiers-grid').DataTable().ajax.reload();
    }
</script>
