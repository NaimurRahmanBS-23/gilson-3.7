                    <a rel="me" target="_blank" class="twitter" href="https://twitter.com/gilsoncompany"></a>
                </li>
                <li>
                    <a rel="me" target="_blank" class="linkedin" href="https://www.linkedin.com/company/gilson-company-inc."></a>
