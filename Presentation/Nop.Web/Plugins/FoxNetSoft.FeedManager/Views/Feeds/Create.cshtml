@model FoxNetSoft.Plugin.Feed.Manager.Models.AddFeedRecModel
@using FoxNetSoft.Plugin.Feed.Manager.Models
@using Nop.Web.Framework
@{
    Layout = "~/Administration/Views/Shared/_AdminLayout.cshtml";
    //page title
    ViewBag.Title = @T("Admin.FoxNetSoft.Plugin.Feed.Manager.Feed.AddNew").Text;
}
<style>
.typefeed-selector-all{
}
.typefeed-selector{
    width: 300px;
    float: left;
    text-align: center;
    border: 4px double grey;
    padding: 5px;
    margin: 5px;
}
.typefeed-selector input{
    margin:0;padding:0;
    -webkit-appearance:none;
       -moz-appearance:none;
            appearance:none;
}

@foreach (var typeFeed in Model.AvailableTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
    @foreach (var typeFeed in Model.GooleTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
    @foreach (var typeFeed in Model.AmazonTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
   @foreach (var typeFeed in Model.EbayTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
   @foreach (var typeFeed in Model.PopularTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
   @foreach (var typeFeed in Model.RakutenTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
   @foreach (var typeFeed in Model.WalmartTypeFeeds)
{
   <text>
         .style-typefeed@(typeFeed.Id){background-image:url(@(typeFeed.PictureUrl));}
   </text>
}
.typefeed-selector input:active +.drinktypefeed-cc{opacity: .9;}
.typefeed-selector input:checked +.drinktypefeed-cc{
    -webkit-filter: none;
       -moz-filter: none;
            filter: none;
    border: 1px dotted gray;
}
.drinktypefeed-cc{
    cursor:pointer;
    background-size:contain;
    background-repeat:no-repeat;
    background-position: center;
    display:inline-block;
    width:300px;
    height:70px;
    background-position-y: 10px;
    /*-webkit-transition: all 100ms ease-in;
       -moz-transition: all 100ms ease-in;
            transition: all 100ms ease-in;
    -webkit-filter: brightness(1.8) grayscale(1) opacity(.7);
       -moz-filter: brightness(1.8) grayscale(1) opacity(.7);
            filter: brightness(1.8) grayscale(1) opacity(.7);
    */
}
.drinktypefeed-cc:hover{
    /*-webkit-filter: brightness(1.2) grayscale(.5) opacity(.9);
       -moz-filter: brightness(1.2) grayscale(.5) opacity(.9);
            filter: brightness(1.2) grayscale(.5) opacity(.9);
    */
}
</style>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "addfeed-form" }))
{
    @Html.AntiForgeryToken()
    <div class="section-header">
        <div class="title">
