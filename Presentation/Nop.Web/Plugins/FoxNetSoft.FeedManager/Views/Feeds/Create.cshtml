            </td>
        </tr>  
        <tr class="adminSeparator">
            <td colspan="2">
                <hr />
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                Another:
            </td>
            <td class="adminData">
                <div class="typefeed-selector-all">
                    @foreach (var typeFeed in Model.AvailableTypeFeeds)
                    {
