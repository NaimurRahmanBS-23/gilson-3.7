                        <text>
                        <div class="typefeed-selector">
                        <input id="typefeed@(typeFeed.Id)" type="radio" name="typefeedid" value="@(typeFeed.Id)" />
                        <label class="drinktypefeed-cc style-typefeed@(typeFeed.Id)" for="typefeed@(typeFeed.Id)">@(typeFeed.Name)</label>
