@model SevenSpikes.Nop.Plugins.AjaxFilters.Models.ProductsModel
@using Nop.Web.Models.Catalog;
@using Nop.Web.Extensions;

<div id="nopAjaxFiltersNoProductsDialog" title="@T("SevenSpikes.NopAjaxFilters.Client.Common.NoResultsFoundTitle")">
    <p>@T("SevenSpikes.NopAjaxFilters.Client.Common.NoResultsFoundMessage")</p>
</div>
@if (Model.Products.Any())
{

    <div class="@Model.NopAjaxFiltersSettingsModel.ProductsGridPanelSelector.TrimStart(new[] { '.' }) nop7SpikesAjaxFiltersGrid">
            <table class="products-table">
                <caption></caption>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="cto"><a href="@Url.RouteUrl("Product", new {product.SeName})" title="@product.DefaultPictureModel.Title"><img alt="@product.DefaultPictureModel.AlternateText" src="@product.DefaultPictureModel.ImageUrl" title="@product.DefaultPictureModel.Title" /></a></div>
                                <div class="cto"><a href="@Url.RouteUrl("Product", new {product.SeName})">@product.Name</a></div>
                                <div class="cto"><span class="label">Model: </span>@product.Sku</div>
                                <div class="cto">
                                    <span class="label responsive">Cut Dimensions L x W, in: </span><input class="qty-input" id="length@(product.Id)" name="length@(product.Id)" type="number" min="1" max="99" value="" title="Length" /> X <input class="qty-input" id="width@(product.Id)" name="width@(product.Id)" type="number" min="1" max="99" value="" title="Width" />
                                </div>
                                <div class="cto">
                                    <span class="label">Piece Qty: </span><input class="qty-input" id="pieceqty@(product.Id)" name="pieceqty@(product.Id)" type="number" min="1" max="99" value="" title="Piece Quantity" />
                                </div>
                                <div class="cto">
                                    <span class="label">Square Feet: </span><input class="sq-ft" id="qty@(product.Id)" name="qty@(product.Id)" type="text" value="" readonly />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(product.ProductPrice.OldPrice))
                                {
                                    <div class="cto"><span class="label">List Price/Sq Ft: </span>@product.ProductPrice.OldPrice</div>
                                        <div class="cto"><span class="label">Dealer Price/Sq Ft: </span><span id="price@(product.Id)" class="price">@product.ProductPrice.Price</span></div>
                                        <div class="cto"><span class="label">Total Dealer Price: </span><span id="tp@(product.Id)"></span></div>
                                }
                                else
                                {
                                    <div class="cto"><span class="label">Price/Sq Ft: </span><span id="price@(product.Id)" class="price">@product.ProductPrice.Price</span></div>
                                        <div class="cto"><span class="label">Total Price: </span><span id="tp@(product.Id)"></span></div>
                                }
                            </td>
                            <td>
                        </tr>}
                </tbody>
            </table>
        </div>

    var pager = Html.Pager(Model.PagingFilteringContext).QueryParam("pagenumber");

    if (!pager.IsEmpty())
    {
        <div class="@Model.NopAjaxFiltersSettingsModel.PagerPanelSelector.TrimStart(new [] {'.'})">
            @pager
        </div>
    }
}

@Html.Hidden("specificationFilterModel7SpikesJson", Model.SpecificationFilterModel7SpikesJson)
@Html.Hidden("attributeFilterModel7SpikesJson", Model.AttributeFilterModel7SpikesJson)
@Html.Hidden("manufacturerFilterModel7SpikesJson", Model.ManufacturerFilterModel7SpikesJson)
@Html.Hidden("vendorFilterModel7SpikesJson", Model.VendorFilterModel7SpikesJson)
@Html.Hidden("onSaleFilterModel7SpikesJson", Model.OnSaleFilterModel7SpikesJson)

@Html.Hidden("urlHashQuery", Model.HashQuery)
@Html.Hidden("currentPageSizeJson", Model.CurrentPageSizeJson)
@Html.Hidden("currentViewModeJson", Model.CurrentViewModeJson)
@Html.Hidden("currentOrderByJson", Model.CurrentOrderByJson)
@Html.Hidden("currentPageNumberJson", Model.CurrentPageNumberJson)
@Html.Hidden("priceRangeFromJson", Model.PriceRangeFromJson)
@Html.Hidden("priceRangeToJson", Model.PriceRangeToJson)
@Html.Hidden("totalCount", Model.TotalCount)