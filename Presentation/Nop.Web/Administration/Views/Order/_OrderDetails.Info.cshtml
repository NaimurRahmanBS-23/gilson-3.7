    @{
        //HACK: Display Checkout attributes (Reference # and Special Instructions) in table
        if (!string.IsNullOrWhiteSpace(Model.CheckoutAttributeInfo))
        {
            var checkoutAttributes = Model.CheckoutAttributeInfo.Split(new[] { "<br />" }, StringSplitOptions.None);
            var referenceNumber = "";
            var specialInstructions = "";
            foreach (var ca in checkoutAttributes)
            {
                if (ca.Contains("Reference #"))
                {
                    referenceNumber = ca.Replace("Reference #: ", "");
                }
                else if (ca.Contains("Special Instructions"))
                {
                    specialInstructions = ca.Replace("Special Instructions: ", "");
                }
            }
            if (!string.IsNullOrWhiteSpace(referenceNumber))
            {
                <tr>
                    <td class="adminTitle"><img alt="The order reference number." src="/Administration/Content/images/ico-help.gif" title="The order reference number."><label title="The order reference number.">Reference #</label>:</td>
                    @if (referenceNumber.ToLower().Contains("<script>"))
                    {
                        <td class="adminData">@Html.Encode(referenceNumber)</td>
                    }
                    else
                    {
                        <td class="adminData">@Html.Raw(referenceNumber)</td>
                    }
                </tr>
            }
            if (!string.IsNullOrWhiteSpace(specialInstructions))
            {
                <tr>
                    <td class="adminTitle"><img alt="Special Instructions for the order." src="/Administration/Content/images/ico-help.gif" title="Special Instructions for the order."><label title="Special Instructions for the order.">Special Instructions</label>:</td>
                    @if (specialInstructions.ToLower().Contains("<script>"))
                    {
                        <td class="adminData">@Html.Encode(specialInstructions)</td>
                    }
                    else
                    {
                        <td class="adminData">@Html.Raw(specialInstructions)</td>
                    }
                </tr>
            }
        }
        }

        @if (Model.CustomValues != null && Model.CustomValues.Count == 1 && Model.CustomValues.ContainsKey("PO Number"))
