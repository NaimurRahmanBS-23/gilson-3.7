@model FooterModel
@using Nop.Web.Models.Common;
<div class="footer">
    <div class="footer-upper">
        <div class="footer-centering">
            <div class="footer-block phone-block">
                <span>@T("SevenSpikes.Themes.Nitro.Footer.Phone.Text")</span>
                <span><a href="tel:+1-800-444-1508">800-444-1508</a></span>
            </div>
            <div class="footer-block payment-info-block">
                <span>@T("SevenSpikes.Themes.Nitro.Footer.Payment.Text1")</span>
                <span>@T("SevenSpikes.Themes.Nitro.Footer.Payment.Text2")</span>
            </div>
            <div class="footer-block accepted-payment-methods">
                <ul>
                    <li class="method1" title="Visa®"></li>
                    <li class="method2" title="MasterCard®"></li>
                    <li class="method3" title="American Express"></li>
                    <li class="method4" title="Purchase Order"></li>
                </ul>
            </div>@{var newsLetterHtml = @Html.Action("NewsletterBox", "Newsletter");}
            @if (!MvcHtmlString.IsNullOrEmpty(newsLetterHtml))
            {
                <div class="footer-block newsletter-block" title="Enter your email to subscribe to the Gilson Newsletter">@newsLetterHtml</div>
            }
        </div>
    </div>
    <div class="footer-middle">
