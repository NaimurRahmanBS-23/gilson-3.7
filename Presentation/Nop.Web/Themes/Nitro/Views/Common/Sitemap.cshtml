    //title
    Html.AddTitleParts(T("PageTitle.Sitemap").Text);

    var sieving = Html.Action("TopicBlock", "Topic", new { systemName = "LHM-Sieving" }).ToString()
        .Replace("<a href=\"/sieve-analysis-equipment\">Sieving</a>", "")
        .Replace(" class=\"lhm-item\"", "");
    var sieveShakers = Html.Action("TopicBlock", "Topic", new { systemName = "LHM-Sieve-Shakers" }).ToString()
