@model IList<ProductOverviewModel>
@using Nop.Web.Models.Catalog;
@if (Model.Count > 0){var p = Model.First();var panCover = (p.Name.ToLower().Contains("pan") ? "Pan" : "Cover");foreach (var product in Model){<tr class="@(product.Name.ToUpper().Contains("PAN") ? "panRow" : "coverRow")"><td><a href="@Url.RouteUrl("Product", new {SeName = product.SeName})"><img src="@product.DefaultPictureModel.ImageUrl" /></a></td><td><a href="@Url.RouteUrl("Product", new {SeName = product.SeName})">@product.Name</a><div><span class="label">Model: </span>@product.Sku</div><div class="prices">@if (!string.IsNullOrWhiteSpace(product.ProductPrice.OldPrice)){<div><span class="label">List Price: </span><span class="list-price">@product.ProductPrice.OldPrice</span></div><span class="label">Dealer Price: </span><span class="price">@product.ProductPrice.Price</span>}else{<div><span class="label">Price: </span><span class="price">@product.ProductPrice.Price</span></div>}</div></td><td><input class="qty-input" id="qty@(product.Id)" name="qty@(product.Id)" type="number" min="1" max="99" value="" title="@(panCover) Quantity"></td></tr>}}