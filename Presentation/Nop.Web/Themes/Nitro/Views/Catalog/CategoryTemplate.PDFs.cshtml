@model CategoryModel
@using Nop.Core
@using Nop.Core.Domain.Common;
@using Nop.Core.Domain.Seo;
@using Nop.Core.Infrastructure;
@using Nop.Services.Localization
@using Nop.Web.Models.Catalog;
@{
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";
    Html.AddTitleParts(!String.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Name);
    Html.AddMetaDescriptionParts(Model.MetaDescription);
    Html.AddMetaKeywordParts(Model.MetaKeywords);

    var storeName = EngineContext.Current.Resolve<IStoreContext>().CurrentStore.GetLocalized(x => x.Name);

    Html.AddHeadCustomParts("<meta property=\"Categories\" data-sj-field=\"category\" content=\"Categories\" />");

    //open graph META tags
    Html.AddHeadCustomParts("<meta property=\"og:type\" content=\"category\" />");
    if (!string.IsNullOrWhiteSpace(Model.OverrideName))
    {
        Html.AddHeadCustomParts("<meta property=\"og:title\" content=\"" + Html.Encode(Model.OverrideName) + "\" />");
    }
    else
    {
        Html.AddHeadCustomParts("<meta property=\"og:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
    }
    Html.AddHeadCustomParts("<meta property=\"og:description\" content=\"" + Html.Encode(Model.MetaDescription) + "\" />");
    Html.AddHeadCustomParts("<meta property=\"og:image\" content=\"" + Model.PictureModel.ImageUrl + "\" />");
    Html.AddHeadCustomParts("<meta property=\"og:url\" content=\"" + Request.Url.AbsoluteUri + "\" />");
    Html.AddHeadCustomParts("<meta property=\"og:site_name\" content=\"" + Html.Encode(storeName) + "\" />");

    //Twitter META tags
    Html.AddHeadCustomParts("<meta property=\"twitter:card\" content=\"summary\" />");
    Html.AddHeadCustomParts("<meta property=\"twitter:site\" content=\"" + Html.Encode(storeName) + "\" />");
    if (!string.IsNullOrWhiteSpace(Model.OverrideName))
    {
        Html.AddHeadCustomParts("<meta property=\"twitter:title\" content=\"" + Html.Encode(Model.OverrideName) + "\" />");
    }
    else
    {
        Html.AddHeadCustomParts("<meta property=\"twitter:title\" content=\"" + Html.Encode(Model.Name) + "\" />");
    }
    Html.AddHeadCustomParts("<meta property=\"twitter:description\" content=\"" + Html.Encode(Model.MetaDescription) + "\" />");
    Html.AddHeadCustomParts("<meta property=\"twitter:image\" content=\"" + Model.PictureModel.ImageUrl + "\" />");
    Html.AddHeadCustomParts("<meta property=\"twitter:url\" content=\"" + Request.Url.AbsoluteUri + "\" />");

    var canonicalUrlsEnabled = EngineContext.Current.Resolve<SeoSettings>().CanonicalUrlsEnabled;
    if (canonicalUrlsEnabled)
    {
        var categoryUrl = Url.RouteUrl("Category", new { SeName = Model.SeName }, this.Request.Url.Scheme);
        Html.AddCanonicalUrlParts(categoryUrl);
    }

}
<div class="page category-page">
    <div class="page-title">
        @if (!string.IsNullOrWhiteSpace(Model.OverrideName))
        {
            <h1>@Model.OverrideName</h1>
        }
        else
        {
            <h1>@Model.Name</h1>
        }
    </div>
    @* ReSharper disable once Mvc.PartialViewNotResolved *@
    @if (Model.DisplayCategoryBreadcrumb)
    {
        @Html.Partial("_CategoryBreadcrumb", Model.CategoryBreadcrumb, new ViewDataDictionary { { "CurrentCategory", Model.Name } })
        @Html.Widget("categorydetails_after_breadcrumb", Model.Id)
    }
    @Html.Partial("_ShareButtons", Model.PageShareCode)
    <div class="page-body">
        @Html.Widget("categorydetails_top", Model.Id)
        @*description*@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="category-description">
                @Html.Raw(Model.Description)
            </div>
        }
            @Html.Widget("categorydetails_before_subcategories", Model.Id)
            @*subcategories*@
            @if (Model.SubCategories.Count > 0)
            {
                <div class="category-grid sub-category-grid">
                    <div class="item-grid">
                        @foreach (var item in Model.SubCategories)
                        {
                            <div class="item-box">
                                <div class="sub-category-item">
                                <h2 class="title"><a href="@(item.Description)?v=@(DateTime.Now.ToString("yyyyMMddHHmmssfff"))" target="_blank">@item.Name</a></h2>
                                    <div class="picture">
                                        <a href="@(item.Description)?v=@(DateTime.Now.ToString("yyyyMMddHHmmssfff"))" target="_blank">
                                            <img loading="lazy" src="@item.PictureModel.ImageUrl" alt="" />
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        </div>
                    </div>
            }

            @*description*@
            @if (!string.IsNullOrWhiteSpace(Model.Description2))
            {
                <div id="description2" class="category-description">
                    @Html.Raw(Model.Description2)
                    @if (Model.Description2.Contains("common-questions"))
                    {
                        <script>$(function () { $(".question").click(function () { $(this).find(".answer").slideToggle(200, 'swing'); $(this).toggleClass("up"); }); });</script>
                    }
                </div>
            }
    </div>
</div>
<script>$(document).on("nopAjaxFiltersFiltrationCompleteEvent", function () { bLazyRevalidate(); });</script>