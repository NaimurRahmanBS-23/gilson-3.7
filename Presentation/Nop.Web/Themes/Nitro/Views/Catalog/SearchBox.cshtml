<div class="search-form"><input type="text" class="search-box-text" id="small-searchterms" autocomplete="off" name="q" placeholder="Search for product or model #" onkeyup="performSearch(event)" value="@Request.QueryString["q"]" data-hj-whitelist /><input type="submit" class="button-1 search-box-button" value="@T("Search.Button")" onclick="performSearch(event);" /></div><script type="text/javascript">$(document).ready(function () { $('#small-searchterms').autocomplete({ source: function (request, response) { var websitePipeline = new SajariSearch.Client("1518648110770120928", "globalgilson-com").pipeline("website"); var clickTrackedSession = new SajariSearch.InteractiveSession("q", new SajariSearch.DefaultSession(SajariSearch.TrackingType.Click, "url", {})); websitePipeline.search({ q: request.term, fields: "image,title,url", "q.override": "true" }, clickTrackedSession, (error, sajariResponse, values) => { response($.map(sajariResponse.results, function (r) { return { label: r.values.title, productpictureurl: r.values.image, producturl: r.values.url, producttoken: r.token.click } })); }); }, delay: 800, minLength: 3, appendTo: '.search-box', select: function (event, ui) { $("#small-searchterms").val(ui.item.label); setLocation(ui.item.producttoken); return false; }, messages: { noResults: '', results: function () { } } }).data("ui-autocomplete")._renderItem = function (ul, item) { var t = item.label; t = htmlEncode(t); return $("<li></li>").data("item.autocomplete", item).append("<a><div style=\"height:100%;\"><img src=\"" + (item.producturl.indexOf(".pdf") > -1 ? "/content/images/small-pdf.png" : (item.productpictureurl !== null && typeof (item.productpictureurl) !== "undefined" ? item.productpictureurl : "/content/images/gilson_no_image.jpg")) + "\" onerror=\"this.src='/content/images/gilson_no_image.jpg'\"></div><div style=\"overflow:hidden;\">" + t + "</div></a>").appendTo(ul); }; });</script>