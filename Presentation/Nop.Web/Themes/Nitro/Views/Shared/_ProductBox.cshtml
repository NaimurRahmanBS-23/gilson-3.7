@model ProductOverviewModel
@using Nop.Core.Domain.Catalog
@using Nop.Core.Domain.Orders
@using Nop.Core.Infrastructure
@using Nop.Web.Models.Catalog;
@{const int shoppingCartTypeId = (int)ShoppingCartType.ShoppingCart; const int quantity = 1; var addtocartlink = Model.ProductPrice.ForceRedirectionAfterAddingToCart ? Url.RouteUrl("AddProductToCart-Catalog", new { productId = Model.Id, shoppingCartTypeId, quantity, forceredirection = Model.ProductPrice.ForceRedirectionAfterAddingToCart }) : Url.RouteUrl("AddProductToCart-Catalog", new { productId = Model.Id, shoppingCartTypeId, quantity, }); var addtocomparelink = Url.RouteUrl("AddProductToCompare", new { productId = Model.Id }); var catalogSettings = EngineContext.Current.Resolve<CatalogSettings>();}
<div class="product-item" data-productid="@Model.Id"><div class="picture"><a href="@Url.RouteUrl("Product", new {Model.SeName})"><img loading="lazy" src="@Model.DefaultPictureModel.ImageUrl" alt="@Model.Name" /></a></div><div class="details">@if (ViewBag.DoNotUseH2Tag != null){<div class="product-title"><a href="@Url.RouteUrl("Product", new {Model.SeName})">@Model.Name</a></div>}else{<h2 class="product-title"><a href="@Url.RouteUrl("Product", new {Model.SeName})">@Model.Name</a></h2>}@if (Model.ReviewOverviewModel.AllowCustomerReviews){var ratingPercent = 0; if (Model.ReviewOverviewModel.TotalReviews != 0) { ratingPercent = ((Model.ReviewOverviewModel.RatingSum * 100) / Model.ReviewOverviewModel.TotalReviews) / 5; }<div class="product-rating-box"><div class="rating"><div style="width: @(ratingPercent)%"></div></div></div>}<div class="add-info"><div class="prices">@if (!String.IsNullOrEmpty(Model.ProductPrice.OldPrice)){if (Model.ProductPrice.OldPrice.StartsWith("Starting")){<div><span class="label">Starting List Price: </span><span class="price old-price">@Model.ProductPrice.OldPrice.Replace("Starting at ", "")</span></div><div><span class="label">Starting Dealer Price: </span><span class="price actual-price">@Model.ProductPrice.Price.Replace("Starting at ", "")</span></div>}else{<div><span class="label">List Price: </span><span class="price old-price">@Model.ProductPrice.OldPrice</span></div><div><span class="label">Dealer Price: </span><span class="price actual-price">@Model.ProductPrice.Price</span></div>}}else{<span class="price actual-price">@Model.ProductPrice.Price</span>}</div></div></div><div class="hover-content"><div class="buttons">@if (catalogSettings.CompareProductsEnabled){<div class="compare-products"><input type="button" value="@T("ShoppingCart.AddToCompareList")" class="button-2 add-to-compare-list-button" onclick="AjaxCart.addproducttocomparelist('@addtocomparelink');return false;" /></div>}@if (!Model.ProductPrice.DisableBuyButton){var addToCartText = T("ShoppingCart.AddToCart").Text; if (Model.ProductPrice.IsRental) { addToCartText = T("ShoppingCart.Rent").Text; }if (Model.ProductPrice.AvailableForPreOrder) { addToCartText = T("ShoppingCart.PreOrder").Text; }<input type="button" value="@(addToCartText)" class="button-2 product-box-add-to-cart-button" onclick="AjaxCart.addproducttocart_catalog('@addtocartlink    ');return false;" />}</div><div href="@Url.RouteUrl("Product", new {Model.SeName})" class="description" onclick="window.location = '@Url.RouteUrl("Product", new {Model.SeName})';"><span>Model@(Model.Sku.Contains(", ") ? "s" : ""): @Model.Sku</span>@Html.Raw(Model.ShortDescription)</div></div></div>