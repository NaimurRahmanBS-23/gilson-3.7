@model CustomerNavigationModel           
@using Nop.Web.Models.Customer;
<div class="block block-account-navigation">
    <div class="title"><strong>@T("Account.Navigation")</strong></div>
    <div class="listbox">
        <ul class="list">
            @Html.Widget("account_navigation_before")
            <li><a href="@Url.RouteUrl("CustomerInfo")" class="inactive">@T("Account.CustomerInfo")</a></li>
            <li><a href="/customer/tax-exemption" class="inactive">Tax Exemption</a></li>
            <li><a href="@Url.RouteUrl("CustomerAddresses")" class="inactive">@T("Account.CustomerAddresses")</a></li>
            <li><a href="@Url.RouteUrl("CustomerOrders")" class="inactive">@T("Account.CustomerOrders")</a></li>
            <li><a href="@Url.RouteUrl("CustomerInvoices")" class="inactive">@T("Account.CustomerInvoices")</a></li>
            <li><a href="@Url.RouteUrl("Wishlist")" class="inactive">@T("Wishlist")</a></li>
            <li><a href="/cart" class="inactive">Shopping Cart</a></li>
            <li><a href="/quick-order" class="inactive">Quick Order</a></li>
            <li><a href="@Url.RouteUrl("CustomerDownloadableProducts")" class="inactive">My Downloads</a></li>

            <li style="margin-top: 25px;"><a href="/customer/changepassword">Change Password</a></li>
            <li><a href="/logout" class="inactive">Logout</a></li>
            @Html.Widget("account_navigation_after")
        </ul>
    </div>
</div>
