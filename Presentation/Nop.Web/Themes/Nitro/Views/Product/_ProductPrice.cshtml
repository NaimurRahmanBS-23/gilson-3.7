@model ProductDetailsModel.ProductPriceModel
@using Nop.Web.Models.Catalog;
@if (Model.CallForPrice){<div class="prices"><div class="product-price call-for-price"><span>@T("Products.CallForPrice")</span></div></div>}else{<div class="prices" itemprop="offers" itemscope itemtype="http://schema.org/Offer">@if (!string.IsNullOrWhiteSpace(Model.OldPrice)){<div><span class="label">List Price: </span><span class="list-price">@Model.OldPrice</span></div><div><span class="label">Dealer Price: </span><span class="product-price" itemprop="price">@Model.Price</span></div>}else{<div class="itemprop-price"><span itemprop="priceCurrency" content="@Model.CurrencyCode">$</span><span class="product-price" itemprop="price">@Model.PriceValue</span></div><div><span class="label">Price: </span><span class="product-price">@Model.Price</span></div>}@if (!Model.CallForPrice){<link itemprop="availability" href="http://schema.org/InStock"/>}</div>}