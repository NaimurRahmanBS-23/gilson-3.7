<script type="text/javascript" src="//static.criteo.net/js/ld/ld.js" async="true"></script><script type="text/javascript">var deviceType = /iPad/.test(navigator.userAgent) ? "t" : /Mobile|iP(hone|od)|Android|BlackBerry|IEMobile|Silk/.test(navigator.userAgent) ? "m" : "d"; window.criteo_q = window.criteo_q || []; window.criteo_q.push({ event: "setAccount", account: 50375 }, { event: "setEmail", email: "@customerEmail" }, { event: "setSiteType", type: deviceType }, { event: "viewItem", item: "@Model.Id" });</script>*@